{
  "name": "@opaque-ui/react",
  "version": "0.1.0",
  "description": "React components for private contact UI rendered in separate-origin iframes",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
