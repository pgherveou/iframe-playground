{
  "name": "iframe-playground",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -k -n host,provider 'npm:dev:host' 'npm:dev:provider'",
    "dev:host": "vite --config apps/host/vite.config.ts",
    "dev:provider": "tsx watch apps/provider/src/server.tsx",
    "build": "npm run typecheck && npm run build -w @opaque-ui/react && vite build --config apps/host/vite.config.ts && tsc -p apps/provider/tsconfig.build.json",
    "build:pages": "npm run build && vite build --config apps/host/vite.config.ts --mode pages && vite build --config apps/provider/vite.static.config.ts",
    "typecheck": "tsc --noEmit",
    "preview": "concurrently -k -n host,provider 'npm:preview:host' 'npm:preview:provider'",
    "preview:host": "vite preview --config apps/host/vite.config.ts",
    "preview:provider": "node apps/provider/dist/server.js",
    "preview:pages": "vite preview --config apps/host/vite.config.ts --mode pages --port 5185",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:pages": "playwright test --config playwright.pages.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@opaque-ui/react": "0.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
